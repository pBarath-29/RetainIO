# Copy to .env and fill in. .env is gitignored; this file is the template.

# ── Database (Supabase) ─────────────────────────────────────────────────────
# Two URLs, and they are not interchangeable.
#
# DATABASE_URL is the POOLED connection (Supabase's transaction pooler, port 6543,
# ?pgbouncer=true). db.ts uses it for every runtime query.
#
# DIRECT_URL is the DIRECT connection (port 5432). prisma.config.ts uses it for migrations,
# because the transaction pooler cannot run schema changes.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Model service ───────────────────────────────────────────────────────────
# The FastAPI service in ../model_service. Every churn, sentiment, fusion, uplift and face
# call goes through it. Defaults to the local address below, so in a deployment this MUST
# be set to the service's internal URL or every prediction fails.
MODEL_SERVICE_URL="http://127.0.0.1:8000"

# ── Gemini ──────────────────────────────────────────────────────────────────
# The AI advisor, the executive diagnosis on the SHAP tab, and the doc-search embeddings.
GEMINI_API_KEY="your-key-here"

# ── Simulated usage telemetry ───────────────────────────────────────────────
# Off unless set to exactly "true". When on, the daily pass advances every account's usage
# readings to today and scores them.
#
# These readings are GENERATED, not measured — see "Simulated usage" in README.md. Without this the
# app still scores every day, but every account reads identical inputs forever, so nothing
# on any trend chart ever moves.
SIMULATE_USAGE="false"

# ── Email ingestion ─────────────────────────────────────────────────────────
# Turns customer feedback emails into reviews, and renewal notice emails into pending notices.
# Off entirely unless HOST, USER and PASSWORD are all set: the poll never starts and
# POST /api/inbox/check returns 503.
#
# USE A DEDICATED MAILBOX, not a personal one. The app holds this credential and reads
# messages in that inbox.
#
# Any IMAP mailbox works — nothing in the code is provider-specific — but signing in is not the
# same everywhere. Gmail, Yahoo and iCloud take an APP PASSWORD, which requires two-step
# verification on that account; a normal account password is refused. Outlook.com and Microsoft
# 365 no longer accept a password at all (basic authentication ended on 30 April 2026) and require
# OAuth, which this code does not implement.
#
#   Yahoo    imap.mail.yahoo.com   993   Account Security -> Generate app password
#   Gmail    imap.gmail.com        993   myaccount.google.com/apppasswords
#   iCloud   imap.mail.me.com      993   appleid.apple.com -> App-Specific Passwords
#
# An app password can be revoked by the provider at any time; when that happens every poll logs
# "Inbox check skipped: Command failed" until a new one is set. Blanking INGEST_IMAP_USER turns
# the whole feature off cleanly in the meantime.
#
# Only unread messages whose subject starts with one of the prefixes below are ever read.
# Everything else is left untouched and unrecorded. The company name is whatever follows the
# prefix, e.g. "RetainIO Feedback: Acme Corp", and a name matching no account, or more than one,
# is recorded as unmatched rather than attached to the closest guess.
INGEST_IMAP_HOST="imap.mail.yahoo.com"
INGEST_IMAP_PORT="993"
INGEST_IMAP_USER=""
INGEST_IMAP_PASSWORD=""
INGEST_SUBJECT_PREFIX="RetainIO Feedback:"
# Renewal notices have their own subject and a fixed body, read by rules - never by a model:
#   Subject: RetainIO Renewal Notice: Acme Corp
#   Request: Downgrade        (Upgrade | Downgrade | Not renewing)
#   Plan: Pro                 (for Upgrade or Downgrade only)
# Recorded as a pending notice at the renewal - never an immediate plan change - and never over a
# notice a manager recorded. Anything in another format is refused, not guessed.
INGEST_NOTICE_SUBJECT_PREFIX="RetainIO Renewal Notice:"
# Optional comma-separated allowlist matched against the sender address. Empty means any
# sender, which is fine for a private mailbox nobody else knows about.
INGEST_ALLOWED_SENDERS=""

# ── Offer emails ────────────────────────────────────────────────────────────
# "Apply Discount & Send Email" sends the retention offer from the same mailbox as above, signing
# in with the same app password - only the provider's outgoing server is set here. Without
# SMTP_HOST the offer is still applied and the window says the email was not sent.
#
#   Yahoo    smtp.mail.yahoo.com   465
#   Gmail    smtp.gmail.com        465
#   iCloud   smtp.mail.me.com      587
SMTP_HOST="smtp.mail.yahoo.com"
SMTP_PORT="465"
# "log" builds each email but sends nothing - for tests.
MAIL_SEND_MODE=""
# Where the demo customers' offers go: prisma/set-contact-emails.ts gives every account this
# address. Empty uses INGEST_IMAP_USER, so the app emails its own mailbox.
DEMO_CONTACT_EMAIL=""

# ── Production only ─────────────────────────────────────────────────────────
# NODE_ENV must be "production" in a deployment. Anything else and server.ts starts an
# in-process Vite dev server instead of serving the built frontend from dist/.
# NODE_ENV="production"
