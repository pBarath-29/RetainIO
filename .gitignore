# Secrets. retainio/.env holds live credentials (retainio/.env.example lists what goes in
# it). A pattern with no slash matches at every level, so this covers it wherever it is.
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
dist/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Local logs and OS noise
*.log
.DS_Store
Thumbs.db

# The usage simulator's record of the rows it created in your own database. The ids mean
# nothing to any other database and the file is rewritten on every run, so it stays local;
# `simulate-usage.ts reset` reads it from there.
retainio/prisma/.simulation-manifest.json

# NOTE: models/ and Datasets/ are deliberately NOT ignored. The FastAPI service loads the
# pickles from models/ and reads Datasets/Churn.csv at import time to rebuild its SHAP
# background sample, so both have to be in the repo for a deploy to boot.
